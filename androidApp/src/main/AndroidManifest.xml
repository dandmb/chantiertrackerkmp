<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ChantierTrackerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChantierTracker">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ChantierTracker.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- No chantiertracker:// Stripe return (ADR-51 point 4) on Android: the Google Play
                 payments policy forbids any payment outside Play, so the app opens none (R6b). -->

            <!-- Real Android App Links (ADR-59) — an invitation email points
                 here, not a custom scheme: the app may not be installed yet,
                 so this needs the OS-level fallback to the browser that only
                 autoVerify="true" + a verified assetlinks.json give. Digital
                 Asset Links verification (com.dmb.chantiertracker.staging,
                 the package currently distributed) confirmed via
                 https://digitalassetlinks.googleapis.com/v1/statements:list
                 before this was added. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="chantiertracker.com"
                    android:pathPattern="/invitations/.*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
